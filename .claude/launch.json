{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "md-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "md-web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "md-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd '../MDApp' && uv run manage.py runserver 0.0.0.0:8000"
      ],
      "port": 8000
    }
  ]
}
