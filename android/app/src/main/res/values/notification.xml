<?xml version="1.0" encoding="utf-8"?>
<!--
    The accent Android tints the notification icon and the app name with.

    Same value as `--ws-color` in `src/app/globals.css`, which is the app's own
    accent everywhere else. It is written out rather than derived because
    nothing links these two files; if the app's accent changes, this changes by
    hand or the notification quietly stops matching the app it came from.
-->
<resources>
    <color name="notification_accent">#A64E12</color>
</resources>
